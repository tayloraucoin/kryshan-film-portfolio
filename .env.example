# Copy to .env.local. Nothing here is required for the public site to build
# and run; every variable belongs to the review layer (docs/REVIEW-LAYER.md).
# Values are read once, by lib/env.ts, and validated with zod at build time.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# The canonical origin, no trailing slash. Used for metadata, sitemap, robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Review layer (the client's design-review round; delete after launch)
# ---------------------------------------------------------------------------
# The gate. "on" (default) requires the access code below; "off" lets every
# /review request through with no code. Local development only: a deployed
# round must be "on" (the review index warns while it is off).
REVIEW_GATE=on

# The code the client types at /review/access. Unset = the review layer is off.
# Six characters or more. Rotating it logs everyone out on the next request.
REVIEW_ACCESS_CODE=

# Signs the review session cookie. Any long random string (16+ chars):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REVIEW_SESSION_SECRET=

# Where comments and the feedback form go: tayloraucoin.com's ingest.
# Origin only, no trailing slash. Unset = comments stay in the reviewer's browser.
REVIEW_BACKEND_URL=https://tayloraucoin.com

# The per-round bearer key, minted in taylor-aucoin with `yarn review:create`.
# Shown once there; paste it here and nowhere else.
REVIEW_INGEST_KEY=
