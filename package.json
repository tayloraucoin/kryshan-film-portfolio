{
  "name": "kryshan-film-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:agent": "NEXT_DIST_DIR=.next-agent next dev -p 4500",
    "build": "next build",
    "build:agent": "NEXT_DIST_DIR=.next-build next build",
    "start": "next start",
    "start:agent": "NEXT_DIST_DIR=.next-build next start -p 4510",
    "lint": "eslint . --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,mjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,mjs,css}\"",
    "docs:check-links": "node scripts/check-doc-links.mjs",
    "verify": "yarn lint && yarn check-types && yarn build:agent"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=22"
  }
}
